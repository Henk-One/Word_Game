<Window x:Class="Desktop.Game.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Word Guessing - LearningPath"
        Width="800"
        Height="760"
        MinWidth="520"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Grid x:Name="RootGrid" Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PageTitle" Grid.Row="0"
                   Text="Word Guessing"
                   Foreground="White"
                   FontSize="36"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,20" />

        <Border x:Name="MenuMetadata" Grid.Row="1"
                Background="#222222"
                BorderBrush="#444444"
                BorderThickness="1"
                CornerRadius="4"
                Padding="20,10"
                HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Language: ENGLISH" Foreground="#CCCCCC" FontSize="18" HorizontalAlignment="Center" />
                <TextBlock Text="Difficulty: BEGINNER" Foreground="#CCCCCC" FontSize="18" HorizontalAlignment="Center" />
                <TextBlock Text="Topic: CAR PARTS" Foreground="#CCCCCC" FontSize="18" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <StackPanel x:Name="MainMenuView" Grid.Row="2"
                    Width="260"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="0,30,0,0">
            <Button x:Name="StartButton"
                    AutomationProperties.AutomationId="btn-start"
                    Content="START GAME"
                    Foreground="#00FF00"
                    BorderBrush="#00FF00"
                    FontSize="18"
                    FontWeight="Bold"
                    Padding="10"
                    Margin="0,0,0,15"
                    Click="StartButton_Click" />
            <Button x:Name="HighscoresButton"
                    AutomationProperties.AutomationId="btn-highscores"
                    Content="HIGHSCORES"
                    Foreground="#FFFF00"
                    BorderBrush="#FFFF00"
                    FontSize="18"
                    FontWeight="Bold"
                    Padding="10"
                    Margin="0,0,0,15"
                    Click="HighscoresButton_Click" />
            <Button x:Name="SettingsButton"
                    AutomationProperties.AutomationId="btn-settings"
                    Content="SETTINGS"
                    Foreground="#66CCFF"
                    BorderBrush="#66CCFF"
                    FontSize="18"
                    FontWeight="Bold"
                    Padding="10"
                    Click="SettingsButton_Click" />
        </StackPanel>
    </Grid>
</Window>
